# Copy this file to .env and fill in real values.
# NEVER commit the real .env file — see .gitignore.
#
# SECURITY NOTE (fixed by this commit): this file previously contained
# real, live production secrets (Supabase service_role key, JWT_SECRET)
# committed in plain text — the exact same values as the ones that were
# also leaked via App-membre's committed .env. Anyone who has ever
# cloned/downloaded either repo has had full read/write/delete access
# to the production database. If you haven't already: rotate the
# Supabase service_role key, JWT_SECRET, DEVICE_TOKEN_SECRET, and
# VITE_BADGE_ENCRYPTION_KEY from the Supabase dashboard / a fresh
# random generator, right now, before anything else.

# --- Client (exposed to the browser via Vite, must start with VITE_) ---
VITE_SUPABASE_URL=https://REPLACE_ME.supabase.co
VITE_SUPABASE_ANON_KEY=REPLACE_ME_WITH_THE_ANON_KEY
VITE_PUBLIC_BUILDER_KEY=__BUILDER_PUBLIC_KEY__
VITE_MEMBERS_PORTAL_URL=https://mon-shm.netlify.app
# AES-256 key (base64), 32 random bytes. MUST be byte-identical to the
# same variable in the members portal repo — see client/lib/badgeCrypto.ts.
# Generate a real one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
VITE_BADGE_ENCRYPTION_KEY=REPLACE_ME_WITH_A_REAL_BASE64_32_BYTE_KEY

# --- Server only (never exposed to the browser) ---
SUPABASE_URL=https://REPLACE_ME.supabase.co
SUPABASE_SERVICE_ROLE_KEY=REPLACE_ME_WITH_THE_SERVICE_ROLE_KEY
JWT_SECRET=REPLACE_ME_WITH_A_LONG_RANDOM_SECRET
PING_MESSAGE="ping pong"

# --- Device trust (offline v2.0) ---
# Separate signing secret for long-lived device tokens (10-day offline
# authorization). Keep this distinct from JWT_SECRET so device tokens
# can be rotated/invalidated independently of session tokens.
DEVICE_TOKEN_SECRET=REPLACE_ME_WITH_A_LONG_RANDOM_SECRET

# --- SMTP (point 5: chef sign-up e-mail + PIN verification) ---
# MUST be the exact same values as App-membre's SMTP_* variables — see
# server/routes/email.ts, which reuses the same `pins` table on the
# same Supabase project.
SMTP_HOST=REPLACE_ME
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=REPLACE_ME
SMTP_PASS=REPLACE_ME_WITH_THE_SAME_VALUE_AS_APP_MEMBRE
