# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

.config/

# Environment files - NEVER commit real secrets.
# (Previously this repo force-included .env via "!.env" — that leaked
# live Supabase/Twilio keys into git history. Rotate those keys.)
.env
.env.local
.env.*.local
!.env.example

# Android / Capacitor build outputs and machine-specific files.
# android/ itself IS committed (the Gradle project, manifest, res/
# files are hand-maintained source) — only the generated/local pieces
# below are excluded, matching what `npx cap add android` itself
# gitignores.
android/local.properties
android/.gradle/
android/captures/
android/app/build/
android/build/
android/*.iml
android/.idea/
android/app/src/main/assets/public/
android/app/src/main/assets/capacitor.config.json
android/app/release/
android/app/debug/
*.apk
*.aab
*.jks
*.keystore
